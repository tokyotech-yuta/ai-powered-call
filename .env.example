# Database (Supabase)
# Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# NextAuth
# Local: http://localhost:3000, Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER_POOL=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET="ai-powered-call-recordings"

# OpenAI (Whisper)
OPENAI_API_KEY=""

# Anthropic (Claude)
ANTHROPIC_API_KEY=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# App
# Local: http://localhost:3000, Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
